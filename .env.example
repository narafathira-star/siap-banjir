# ===== Database =====
# Lokal: PostgreSQL yang diinstal langsung di Windows (lihat docs/DECISIONS.md D-001).
# Neon/Supabase: DATABASE_URL = URL pooled (pgbouncer), DIRECT_URL = URL koneksi langsung.
DATABASE_URL="postgresql://siapbanjir:siapbanjir@localhost:5432/siapbanjir?schema=public"
DIRECT_URL="postgresql://siapbanjir:siapbanjir@localhost:5432/siapbanjir?schema=public"

# ===== Open-Meteo =====
# Gratis, tanpa API key.
OPEN_METEO_BASE_URL="https://api.open-meteo.com/v1/forecast"

# ===== Web Push (VAPID) =====
# Buat dengan: npx web-push generate-vapid-keys --json
# Private key HANYA di server; jangan pernah diberi awalan NEXT_PUBLIC_.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Kontak pengelola (mailto: atau https:). Gunakan alamat asli; Apple bisa menolak alamat contoh.
VAPID_SUBJECT="mailto:admin@example.com"

# ===== Cron =====
# String acak minimal 16 karakter, misal:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Dikirim sebagai header Authorization: Bearer <CRON_SECRET>
CRON_SECRET=""

# ===== Aplikasi =====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
